@{
    ViewData["Title"] = "Главная страница";
}

<section class="hero-section bg-light py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-primary mb-4">
                    Кадастровый учет недвижимости
                </h1>
                <p class="lead mb-4">
                    Современная система для подачи заявлений на кадастровый учет 
                    и получения выписок онлайн. Быстро, удобно и надежно.
                </p>
                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    @if (Context.Session.GetString("UserType") == "Citizen")
                    {
                        @* Для пользователя гражданин *@
                        <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="CadastralObject" asp-action="MyCadastralObjects">
                            Мои кадастровые объекты
                        </a>
                        <a class="btn btn-primary btn-lg px-4 me-md-2" asp-controller="Application" asp-action="Create">
                            Подать заявление
                        </a>
                        <a class="btn btn-outline-secondaty btn-lg px-4" asp-controller="Extract" asp-action="MyExtracts">
                             Мои выписки
                        </a>
                    }
                    else if (Context.Session.GetString("UserId") != null)
                    {
                        @* Для пользователя работник*@
                        <a class="btn btn-primary btn-lg px-4 me-md-2" asp-controller="Application" asp-action="ViewAll">
                            Посмотреть заявления
                        </a>
                        if (Context.Session.GetString("UserType") == "Admin")
                        {
                            @* Для пользователя админ*@
                            <a class="btn btn-primary btn-lg px-4 me-md-2" asp-controller="Account" asp-action="ViewAll">
                                Посмотреть все аккаунты
                            </a>
                        }
                    }
                    else
                    {
                        @* Для неавторизованного пользователя *@
                        <a class="btn btn-primary btn-lg px-4 me-md-2" asp-controller="Account" asp-action="Login">
                            Войти в систему
                        </a>
                        <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Home" asp-action="About">
                            Узнать больше
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <!-- Заглушка для графики -->
                <div class="text-center">
                    <div class="bg-primary text-white rounded-3 p-5">
                        <i class="fas fa-building fa-5x mb-3"></i>
                        <h4>Визуализация системы</h4>
                        <p class="mb-0">Интерактивная карта и статистика</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Таблица кадастровых объектов -->
@if (Context.Session.GetString("UserType") == "Employee" || Context.Session.GetString("UserType") == "Admin")
{
    <section class="features-section py-5">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col">
                    <h2 class="fw-bold">Кадастровые объекты</h2>
                    <p class="text-muted">Управление объектами недвижимости</p>
                </div>
            </div>

            <!-- Поиск и фильтры -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <form method="get" asp-controller="Home" asp-action="Index" class="row g-3">
                                <div class="col-md-4">
                                    <select class="form-select" name="searchType">
                                        <option value="cadastralNumber" selected="@(ViewBag.SearchType == "cadastralNumber")">По кадастровому номеру</option>
                                        <option value="address" selected="@(ViewBag.SearchType == "address")">По адресу</option>
                                        <option value="owner" selected="@(ViewBag.SearchType == "owner")">По владельцу</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="form-control" name="search" 
                                           placeholder="Введите текст для поиска..." value="@ViewBag.Search">
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-search"></i> Поиск
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Таблица объектов -->
            <div class="row">
                <div class="col-md-12">
                    <div class="card shadow">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-list"></i> Список объектов</h5>
                            <a asp-controller="CadastralObject" asp-action="Create" class="btn btn-light btn-sm">
                                <i class="fas fa-plus"></i> Добавить объект
                            </a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Кадастровый номер</th>
                                            <th>Адрес</th>
                                            <th>Площадь</th>
                                            <th>Тип</th>
                                            <th>Владелец</th>
                                            <th>Дата регистрации</th>
                                            <th>Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ViewBag.CadastralObjects != null && ((List<CadastralObject>)ViewBag.CadastralObjects).Count > 0)
                                        {
                                            @foreach (var obj in (List<CadastralObject>)ViewBag.CadastralObjects)
                                            {
                                                <tr>
                                                    <td>
                                                        <strong>@obj.CadastralNumber</strong>
                                                    </td>
                                                    <td>@obj.Address</td>
                                                    <td>@obj.Area.ToString("0.00") кв.м</td>
                                                    <td>
                                                        <span class="badge bg-info">@obj.CadastralObjectType</span>
                                                    </td>
                                                    <td>
                                                        @if (obj.Owner?.User != null)
                                                        {
                                                            <div>@obj.Owner.User.FullName</div>
                                                            <small class="text-muted">@obj.Owner.User.Login</small>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-danger">Нет данных</span>
                                                        }
                                                    </td>
                                                    <td>@obj.RegistrationDate.ToString("dd.MM.yyyy")</td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm" role="group">
                                                            <a href="@Url.Action("Edit", "CadastralObject", new { id = obj.CadastralObjectId })" 
                                                               class="btn btn-outline-primary" title="Редактировать">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <a href="@Url.Action("Details", "CadastralObject", new { id = obj.CadastralObjectId })" 
                                                               class="btn btn-outline-info" title="Просмотр">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-outline-danger" 
                                                                    onclick="confirmDelete(@obj.CadastralObjectId, '@obj.CadastralNumber')" title="Удалить">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4">
                                                    <i class="fas fa-database fa-2x text-muted mb-3"></i>
                                                    <p class="text-muted">Нет данных для отображения</p>
                                                    <a asp-controller="CadastralObject" asp-action="Create" class="btn btn-primary">
                                                        <i class="fas fa-plus"></i> Добавить первый объект
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Пагинация -->
                        @if (ViewBag.TotalPages > 1)
                        {
                            <div class="card-footer">
                                <nav aria-label="Навигация по страницам">
                                    <ul class="pagination justify-content-center mb-0">
                                        @if (ViewBag.CurrentPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" 
                                                   href="@Url.Action("Index", "Home", new { page = ViewBag.CurrentPage - 1, search = ViewBag.Search, searchType = ViewBag.SearchType })">
                                                    <i class="fas fa-chevron-left"></i>
                                                </a>
                                            </li>
                                        }

                                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                <a class="page-link" 
                                                   href="@Url.Action("Index", "Home", new { page = i, search = ViewBag.Search, searchType = ViewBag.SearchType })">
                                                    @i
                                                </a>
                                            </li>
                                        }

                                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" 
                                                   href="@Url.Action("Index", "Home", new { page = ViewBag.CurrentPage + 1, search = ViewBag.Search, searchType = ViewBag.SearchType })">
                                                    <i class="fas fa-chevron-right"></i>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                    <div class="text-center mt-2">
                                        <small class="text-muted">
                                            Страница @ViewBag.CurrentPage из @ViewBag.TotalPages
                                            @{
                                                var currentPage = ViewBag.CurrentPage as int? ?? 1;
                                                var pageSize = ViewBag.PageSize as int? ?? 10;
                                                var totalItems = ViewBag.TotalItems as int? ?? 0;
            
                                                var start = (currentPage - 1) * pageSize + 1;
                                                var end = Math.Min(currentPage * pageSize, totalItems);
            
                                                if (totalItems > 0)
                                                {
                                                    <text>(@start - @end из @totalItems объектов)</text>
                                                }
                                            }
                                        </small>
                                    </div>
                                </nav>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        function confirmDelete(id, cadastralNumber) {
            if (confirm(`Вы уверены, что хотите удалить объект с кадастровым номером "${cadastralNumber}"?`)) {
                window.location.href = '@Url.Action("Delete", "CadastralObject")' + '?id=' + id;
            }
        }
    </script>
}

<!-- Преимущества -->
<section class="features-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col">
                <h2 class="fw-bold">Наши преимущества</h2>
                <p class="text-muted">Почему выбирают нашу систему</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-bolt fa-2x"></i>
                        </div>
                        <h5 class="card-title">Быстро</h5>
                        <p class="card-text">Подача заявления занимает не более 10 минут</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-lock fa-2x"></i>
                        </div>
                        <h5 class="card-title">Безопасно</h5>
                        <p class="card-text">Все данные защищены и хранятся в зашифрованном виде</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-clock fa-2x"></i>
                        </div>
                        <h5 class="card-title">Круглосуточно</h5>
                        <p class="card-text">Система доступна 24/7 с любого устройства</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@{
    ViewData["Title"] = "О нас";
}

<div class="container py-5">
    <!-- Заголовок -->
    <div class="row text-center mb-5">
        <div class="col">
            <h1 class="display-4 fw-bold text-primary mb-3">
                <i class="fas fa-info-circle me-2"></i>О нашей системе
            </h1>
            <p class="lead text-muted">
                Современная платформа для эффективного управления кадастровыми данными
            </p>
        </div>
    </div>

    <!-- Основной контент -->
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="card-title text-primary mb-4">
                        <i class="fas fa-building me-2"></i>Кадастровый учет недвижимости
                    </h3>
                    
                    <p class="card-text mb-4">
                        <strong>Кадастровое управление</strong> — это государственная информационная система, 
                        созданная для ведения единого государственного реестра недвижимости. 
                        Наша система обеспечивает полный цикл работы с объектами недвижимости: от регистрации 
                        до выдачи официальных выписок.
                    </p>
                    
                    <div class="alert alert-info">
                        <i class="fas fa-bullseye me-2"></i>
                        <strong>Наша миссия:</strong> Сделать процессы кадастрового учета прозрачными, 
                        доступными и эффективными для всех участников рынка недвижимости.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Наши преимущества -->
    <div class="row mb-5">
        <div class="col-12">
            <h3 class="text-center mb-4">
                <i class="fas fa-star me-2 text-warning"></i>Почему выбирают нас
            </h3>
        </div>
        
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="text-primary mb-3">
                        <i class="fas fa-shield-alt fa-3x"></i>
                    </div>
                    <h5 class="card-title">Безопасность данных</h5>
                    <p class="card-text">
                        Все данные защищены по стандартам информационной безопасности. 
                        Мы используем современные технологии шифрования и защиты.
                    </p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="text-primary mb-3">
                        <i class="fas fa-clock fa-3x"></i>
                    </div>
                    <h5 class="card-title">Экономия времени</h5>
                    <p class="card-text">
                        Подача заявлений онлайн без очередей. Среднее время обработки 
                        заявки сокращено по сравнению с традиционными методами.
                    </p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="text-primary mb-3">
                        <i class="fas fa-check-circle fa-3x"></i>
                    </div>
                    <h5 class="card-title">Гарантия качества</h5>
                    <p class="card-text">
                        Все операции соответствуют законодательству РФ. 
                        Мы работаем в соответствии со всеми Федеральными законами.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Статистика -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card bg-light border-0">
                <div class="card-body p-4">
                    <h4 class="text-center mb-4">
                        <i class="fas fa-chart-line me-2 text-success"></i>Наша статистика
                    </h4>
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <div class="display-6 fw-bold text-primary">5000+</div>
                            <p class="text-muted">Зарегистрированных объектов</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="display-6 fw-bold text-primary">99%</div>
                            <p class="text-muted">Успешно обработанных заявок</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="display-6 fw-bold text-primary">24/7</div>
                            <p class="text-muted">Доступность системы</p>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="display-6 fw-bold text-primary">15 мин</div>
                            <p class="text-muted">Среднее время обработки</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ключевые функции -->
    <div class="row mb-5">
        <div class="col-12">
            <h3 class="text-center mb-4">
                <i class="fas fa-cogs me-2 text-primary"></i>Ключевые функции системы
            </h3>
        </div>
        
        <div class="col-lg-10 mx-auto">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-file-alt text-primary fa-2x me-3"></i>
                        </div>
                        <div>
                            <h5>Регистрация объектов</h5>
                            <p class="text-muted">
                                Полный цикл регистрации и обновления информиции о земельных участках,
                                зданиях и помещениях с проверкой данных.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-search text-primary fa-2x me-3"></i>
                        </div>
                        <div>
                            <h5>Поиск и проверка</h5>
                            <p class="text-muted">
                                Быстрый поиск по кадастровым номерам и адресам. 
                                Проверка актуальности информации об объектах.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-download text-primary fa-2x me-3"></i>
                        </div>
                        <div>
                            <h5>Электронные выписки</h5>
                            <p class="text-muted">
                                Генерация официальных выписок в электронном виде.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-history text-primary fa-2x me-3"></i>
                        </div>
                        <div>
                            <h5>История изменений</h5>
                            <p class="text-muted">
                                Полная история всех изменений кадастровых объектов 
                                с указанием дат и ответственных лиц.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Для кого предназначена система -->
    <div class="row mb-5">
        <div class="col-12">
            <h3 class="text-center mb-4">
                <i class="fas fa-users me-2 text-info"></i>Для кого предназначена система
            </h3>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Для граждан</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Подача заявлений онлайн</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Запрос выписок</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Отслеживание статуса заявок</li>
                        <li><i class="fas fa-check text-success me-2"></i>Доступ к истории своих объектов</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-warning">
                <div class="card-header bg-warning text-white text-center">
                    <h5 class="mb-0"><i class="fas fa-user-tie me-2"></i>Для сотрудников</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Обработка заявлений</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Ведение реестра объектов</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-success">
                <div class="card-header bg-success text-white text-center">
                    <h5 class="mb-0"><i class="fas fa-user-shield me-2"></i>Для администраторов</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Управление пользователями</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Мониторинг системы</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Технологии -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card bg-light border-0">
                <div class="card-body p-4">
                    <h4 class="text-center mb-4">
                        <i class="fas fa-laptop-code me-2 text-primary"></i>Технологический стек
                    </h4>
                    <div class="row text-center">
                        <div class="col-md-2 col-4 mb-3">
                            <i class="fab fa-windows fa-3x text-primary mb-2"></i>
                            <p>ASP.NET Core</p>
                        </div>
                        <div class="col-md-2 col-4 mb-3">
                            <i class="fas fa-database fa-3x text-primary mb-2"></i>
                            <p>MySQL</p>
                        </div>
                        <div class="col-md-2 col-4 mb-3">
                            <i class="fab fa-html5 fa-3x text-danger mb-2"></i>
                            <p>HTML5/CSS3</p>
                        </div>
                        <div class="col-md-2 col-4 mb-3">
                            <i class="fab fa-js-square fa-3x text-warning mb-2"></i>
                            <p>JavaScript</p>
                        </div>
                        <div class="col-md-2 col-4 mb-3">
                            <i class="fab fa-bootstrap fa-3x text-purple mb-2"></i>
                            <p>Bootstrap 5</p>
                        </div>
                        <div class="col-md-2 col-4 mb-3">
                            <i class="fas fa-shield-alt fa-3x text-success mb-2"></i>
                            <p>SSL/TLS</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Призыв к действию -->
    <div class="row">
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body text-center p-5">
                    <h3 class="card-title mb-4">Готовы начать работу?</h3>
                    <p class="card-text mb-4">
                        Присоединяйтесь к тысячам пользователей, которые уже доверяют нам 
                        управление своими кадастровыми данными.
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        @if (Context.Session.GetString("UserId") == null)
                        {
                            <a class="btn btn-light btn-lg px-4 me-md-2" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-2"></i>Зарегистрироваться
                            </a>
                            <a class="btn btn-outline-light btn-lg px-4" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-2"></i>Войти в систему
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-light btn-lg px-4 me-md-2" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-2"></i>На главную
                            </a>
                            @if (Context.Session.GetString("UserType") == "Citizen")
                            {
                                <a class="btn btn-outline-light btn-lg px-4" asp-controller="Application" asp-action="Create">
                                    <i class="fas fa-file-alt me-2"></i>Подать заявление
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Контактная информация -->
    <div class="row mt-5">
        <div class="col-12 text-center">
            <h5 class="mb-3"><i class="fas fa-headset me-2"></i>Техническая поддержка</h5>
            <p class="text-muted">
                <i class="fas fa-envelope me-2"></i>support@cadastral-management.ru<br>
                <i class="fas fa-phone me-2"></i>8 (915) 799-07-44<br>
            </p>
            <p class="text-muted small mt-4">
                © @DateTime.Now.Year Кадастровое управление. Все права защищены.
            </p>
        </div>
    </div>
</div>

<style>
    .text-purple {
        color: #6f42c1 !important;
    }
    
    .card {
        transition: transform 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-5px);
    }
    
    .border-primary {
        border-width: 2px !important;
    }
    
    .border-warning {
        border-width: 2px !important;
    }
    
    .border-success {
        border-width: 2px !important;
    }
</style>
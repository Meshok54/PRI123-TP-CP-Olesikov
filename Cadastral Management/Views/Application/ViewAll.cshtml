@model List<Cadastral_Management.Models.Application>
@{
    ViewData["Title"] = "Все заявления";
    
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Принят к проверке" => "bg-secondary",
            "На проверке" => "bg-warning text-dark",
            "Одобрен" => "bg-success",
            "Отклонен" => "bg-danger",
            _ => "bg-secondary"
        };
    }
    
    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Принят к проверке" => "fa-clock",
            "На проверке" => "fa-user-check",
            "Одобрен" => "fa-check-circle",
            "Отклонен" => "fa-times-circle",
            _ => "fa-question-circle"
        };
    }
    
    // Функция для получения класса типа объекта
    string GetObjectTypeBadgeClass(string objectType)
    {
        return objectType switch
        {
            "Земельный участок" => "bg-success",
            "Здание" => "bg-primary",
            "Помещение" => "bg-info",
            _ => "bg-secondary"
        };
    }
}

<div class="container mt-4">
    <!-- Заголовок и статистика -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="fw-bold text-primary">
                    <i class="fas fa-tasks me-2"></i>Все заявления
                </h1>
                <div>
                    <a asp-action="ViewAll" asp-route-status="Принят к проверке" 
                       class="btn btn-sm @(ViewBag.StatusFilter == "Принят к проверке" ? "btn-secondary" : "btn-outline-secondary")">
                        Ожидают: <span class="badge bg-light text-dark">@ViewBag.PendingCount</span>
                    </a>
                    <a asp-action="ViewAll" asp-route-status="all" 
                       class="btn btn-sm @(ViewBag.StatusFilter == "all" ? "btn-primary" : "btn-outline-primary")">
                        Все: <span class="badge bg-light text-dark">@ViewBag.TotalCount</span>
                    </a>
                </div>
            </div>
            <hr>
        </div>
    </div>

    <!-- Статистика -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-secondary">
                <div class="card-body text-center py-3">
                    <div class="display-6 fw-bold text-secondary">@ViewBag.PendingCount</div>
                    <div class="text-muted">Ожидают проверки</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-warning">
                <div class="card-body text-center py-3">
                    <div class="display-6 fw-bold text-warning">@ViewBag.InProgressCount</div>
                    <div class="text-muted">В процессе</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-success">
                <div class="card-body text-center py-3">
                    <div class="display-6 fw-bold text-success">@ViewBag.CompletedCount</div>
                    <div class="text-muted">Завершено</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-primary">
                <div class="card-body text-center py-3">
                    <div class="display-6 fw-bold text-primary">@Model.Count</div>
                    <div class="text-muted">Показано</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-3">
                    <form method="get" asp-action="ViewAll" class="row g-2">
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
                                <option value="all" selected="@(ViewBag.StatusFilter == "all")">Все статусы</option>
                                <option value="Принят к проверке" selected="@(ViewBag.StatusFilter == "Принят к проверке")">Ожидают проверки</option>
                                <option value="На проверке" selected="@(ViewBag.StatusFilter == "На проверке")">В процессе</option>
                                <option value="Одобрен" selected="@(ViewBag.StatusFilter == "Одобрен")">Одобрены</option>
                                <option value="Отклонен" selected="@(ViewBag.StatusFilter == "Отклонен")">Отклонены</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" name="type" onchange="this.form.submit()">
                                <option value="all" selected="@(ViewBag.TypeFilter == "all")">Все типы</option>
                                <option value="Регистрация" selected="@(ViewBag.TypeFilter == "Регистрация")">Регистрация</option>
                                <option value="Обновление" selected="@(ViewBag.TypeFilter == "Обновление")">Обновление</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" placeholder="Поиск по ID, имени, адресу..." 
                                       name="search" value="@ViewBag.Search">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search"></i>
                                </button>
                                <a asp-action="ViewAll" class="btn btn-outline-secondary">
                                    <i class="fas fa-redo"></i>
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Таблица заявлений -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th width="80">ID</th>
                                        <th>Дата подачи</th>
                                        <th>Заявитель</th>
                                        <th>Тип заявления</th>
                                        <th width="250">Объект / Адрес</th>
                                        <th>Площадь</th>
                                        <th>Тип объекта</th>
                                        <th>Статус</th>
                                        <th>Ответственный</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@app.ApplicationId</strong>
                                            </td>
                                            <td>
                                                @app.ApplicationDate.ToString("dd.MM.yyyy")
                                                <br>
                                                <small class="text-muted">@app.ApplicationDate.ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                @if (app.Applicant?.User != null)
                                                {
                                                    <div>@app.Applicant.User.FullName</div>
                                                    <small class="text-muted">ID: @app.ApplicantId</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">ID: @app.ApplicantId</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @(app.ApplicationType == "Регистрация" ? "bg-info" : "bg-warning")">
                                                    @app.ApplicationType
                                                </span>
                                            </td>
                                            <td>
                                                <!-- Отображение адреса из заявления -->
                                                <div data-bs-toggle="tooltip" data-bs-placement="top" 
                                                     title="Адрес из заявления: @app.Address">
                                                    <small class="fw-bold">@app.Address</small>
                                                </div>
                                                
                                                <!-- Если есть связанный объект, показываем кадастровый номер -->
                                                @if (app.CadastralObjectId.HasValue && app.CadastralObject != null)
                                                {
                                                    <small class="text-muted">
                                                        <i class="fas fa-hashtag me-1"></i>
                                                        @app.CadastralObject.CadastralNumber
                                                    </small>
                                                }
                                                else if (app.ApplicationType == "Обновление")
                                                {
                                                    <small class="text-warning">
                                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                                        Обновление существующего объекта
                                                    </small>
                                                }
                                                else
                                                {
                                                    <small class="text-success">
                                                        <i class="fas fa-plus-circle me-1"></i>
                                                        Новый объект
                                                    </small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark">
                                                    @app.Area.ToString("N2") м²
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @GetObjectTypeBadgeClass(app.CadastralObjectType)">
                                                    @app.CadastralObjectType
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(app.ApplicationStatus)">
                                                    <i class="fas @GetStatusIcon(app.ApplicationStatus) me-1"></i>
                                                    @app.ApplicationStatus
                                                </span>
                                            </td>
                                            <td>
                                                @if (app.AssignedEmployee?.User != null)
                                                {
                                                    <small>@app.AssignedEmployee.User.FullName</small>
                                                }
                                                else if (app.ApplicationStatus == "На проверке")
                                                {
                                                    <small class="text-warning">Требуется назначение</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Не назначен</small>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="@Url.Action("Verify", "Application", new { id = app.ApplicationId })" 
                                                       class="btn btn-outline-primary" title="Проверить">
                                                        <i class="fas fa-search"></i>
                                                    </a>
                                                    @if (app.ApplicationStatus == "Принят к проверке")
                                                    {
                                                        <a href="@Url.Action("Verify", "Application", new { id = app.ApplicationId })" 
                                                           class="btn btn-outline-warning" title="Взять в работу">
                                                            <i class="fas fa-user-check"></i>
                                                        </a>
                                                    }
                                                    @if (app.Attachments != null && app.Attachments.Any())
                                                    {
                                                        <button class="btn btn-outline-info" 
                                                                onclick="showAttachments(@app.ApplicationId)" title="Документы">
                                                            <i class="fas fa-paperclip"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Нет заявлений</h5>
                            <p class="text-muted mb-4">По выбранным фильтрам заявлений не найдено</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для документов -->
<div class="modal fade" id="attachmentsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-paperclip me-2"></i>Прикрепленные документы</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="attachmentsList">
                <!-- Список документов будет загружен через AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAttachments(applicationId) {
            // Загружаем документы через AJAX
            $.get('@Url.Action("GetAttachments", "Application")', { id: applicationId }, function(data) {
                $('#attachmentsList').html(data);
                new bootstrap.Modal(document.getElementById('attachmentsModal')).show();
            });
        }
        
        // Инициализация tooltip
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
        
        // Автообновление каждые 30 секунд для новых заявлений
        setTimeout(function() {
            if (window.location.href.includes('status=all') || window.location.href.includes('status=Принят')) {
                window.location.reload();
            }
        }, 30000);
    </script>
}
		<RootNamespace>Cadastral_Management</RootNamespace>
		<StartupObject>Cadastral_Management.Program</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
